# ==============================================================================
# Environment Configuration Template for KYC Document Sorter (Docker)
# Copy this file to .env and adjust variables for your deployment environment.
# NO SENSITIVE SECRETS OR PASSWORDS SHOULD BE STORED IN THIS FILE.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Directory Mounts (Host Paths)
# ------------------------------------------------------------------------------
# Absolute or relative paths on the host system to mount into the container:
HOST_INPUT_DIR=D:\KYC_Document_sorter_VLM_ONLY\Source Files\data
HOST_OUTPUT_DIR=D:\KYC_Document_sorter_VLM_ONLY\Destination files
HOST_JOURNAL_DIR=./data/journal
HOST_LOG_DIR=./data/logs

# Container internal mount paths (matches Dockerfile defaults):
KYC_INPUT_DIR=/data/input
KYC_OUTPUT_DIR=/data/output
KYC_JOURNAL_PATH=/data/journal/kyc_journal.db
KYC_LOG_DIR=/data/logs

# ------------------------------------------------------------------------------
# 2. Vision-Language Model (VLM) & Ollama Network Configuration
# ------------------------------------------------------------------------------
# Model name to request from Ollama:
KYC_VLM_MODEL=qwen3-vl:4b-instruct

# Ollama API Endpoint Options:
#
# A) Ollama running directly on Docker Host (Windows / macOS / Linux with host-gateway):
#    KYC_VLM_ENDPOINT=http://host.docker.internal:11434/api/chat
#
# B) Ollama running on a remote dedicated GPU server:
#    KYC_VLM_ENDPOINT=http://192.168.1.50:11434/api/chat
#
# C) Ollama running inside the same Docker Compose network:
#    KYC_VLM_ENDPOINT=http://ollama:11434/api/chat
KYC_VLM_ENDPOINT=http://host.docker.internal:11434/api/chat

# Request timeout in seconds (default: 300)
KYC_VLM_TIMEOUT=300

# Maximum retries for transient Ollama errors (HTTP 502/503/504, connection drops)
KYC_VLM_MAX_RETRIES=3

# ------------------------------------------------------------------------------
# 3. Processing & Concurrency Settings
# ------------------------------------------------------------------------------
# Number of parallel worker threads sending requests to Ollama
KYC_MAX_WORKERS=4

# Incremental batch stream size (guarantees O(1) memory for up to 100,000 files)
KYC_BATCH_SIZE=100

# File operation mode: 'move' (default, moves sorted files) or 'copy' (retains source)
KYC_OPERATION=copy

# Dry-run test mode: 'true' simulates classification without moving/modifying files
KYC_DRY_RUN=false

# Confidence threshold [0.0 - 1.0] required to accept KYC classification
KYC_CONFIDENCE_THRESHOLD=0.80

# CPU throttle protection thresholds (%)
KYC_CPU_LIMIT_PERCENT=80
KYC_CPU_THROTTLE_PERCENT=75

# Optional processing limit (set integer to test a subset, or leave empty for all)
KYC_LIMIT=

# ------------------------------------------------------------------------------
# 4. Watcher Mode Settings
# ------------------------------------------------------------------------------
# Maximum backpressure overflow buffer size for filesystem events
KYC_WATCHER_MAX_QUEUE=1000

# Detect new files by re-scanning the input folder on a timer instead of OS file events.
# Keep 'true' when the input folder is a Windows/macOS path mounted into the container;
# 'false' is only reliable on a native Linux Docker host.
KYC_WATCHER_USE_POLLING=true

# Seconds between folder scans when polling is enabled
KYC_WATCHER_POLLING_INTERVAL=5
